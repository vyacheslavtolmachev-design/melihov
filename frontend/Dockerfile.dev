FROM node:22-alpine

WORKDIR /app

# Бинд-маунт с Windows не отдаёт inotify-события в контейнер, поэтому опрос файлов.
ENV NEXT_TELEMETRY_DISABLED=1 \
    WATCHPACK_POLLING=true \
    CHOKIDAR_USEPOLLING=true

COPY package.json package-lock.json* ./
RUN npm install

COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev"]
